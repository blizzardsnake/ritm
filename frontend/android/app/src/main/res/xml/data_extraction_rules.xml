<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 (API 31) and later: the same rule as backup_rules.xml for the cloud backup, where
     the 25 MB cap applies. A device-to-device transfer has no such cap, and a phone moved to a
     new one should arrive with its photos and videos. Device-only lock credentials are excluded
     from both cloud backups and transfers; the new phone configures its own optional lock. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="opengym-media/" />
        <exclude domain="sharedpref" path="ritm_lock.xml" />
        <exclude domain="sharedpref" path="ritm_health.xml" />
    </cloud-backup>
    <device-transfer><exclude domain="sharedpref" path="ritm_lock.xml" /><exclude domain="sharedpref" path="ritm_health.xml" /></device-transfer>
</data-extraction-rules>
